# ------------------------------------------------------------------------------
# Forest plot helper
# ------------------------------------------------------------------------------

forest_ratio_plot <- function(dat, xlab) {
  
  dat <- dat %>%
    mutate(
      result_label = sprintf(
        "%.2f (%.2f-%.2f)",
        estimate,
        lower,
        upper
      )
    )
  
  label_x <- max(dat$upper, na.rm = TRUE) * 1.15
  dat$label_x <- label_x
  
  xmin <- min(dat$lower, na.rm = TRUE) * 0.90
  xmax <- max(label_x * 1.55, 1.15)
  
  ggplot(
    dat,
    aes(
      x = estimate,
      y = method
    )
  ) +
    geom_vline(
      xintercept = 1,
      linetype = 2,
      linewidth = 0.5
    ) +
    geom_segment(
      aes(
        x = lower,
        xend = upper,
        yend = method
      ),
      linewidth = 0.7
    ) +
    geom_point(size = 2.8) +
    geom_text(
      aes(
        x = label_x,
        label = result_label
      ),
      hjust = 0,
      size = 3.5
    ) +
    scale_x_log10() +
    coord_cartesian(
      xlim = c(xmin, xmax),
      clip = "off"
    ) +
    labs(
      x = xlab,
      y = NULL
    ) +
    theme_classic(base_size = 12) +
    theme(
      axis.text.y = element_text(size = 11),
      plot.margin = margin(5.5, 85, 5.5, 5.5)
    )
}


