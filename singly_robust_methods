)


# ------------------------------------------------------------------------------
# Propensity-score numerator model
# Marginal P(A) for stabilised ATE weights
# ------------------------------------------------------------------------------

ps_num_fit <- glm(
  empa ~ 1,
  family = binomial(link = "logit"),
  data = df
)

