# ------------------------------------------------------------------------------
# Propensity-score denominator model
# ------------------------------------------------------------------------------

ps_denom_formula <- empa ~
  # Demographics
  male +
  cohort_year_recoded +
  age_at_initiation +
  I(age_at_initiation^2) +
  
  # Other baseline covariates
  completed_eth_recoded +
  mi_eth_recoded +
  
  completed_smoking_status +
  mi_smoking_status +
  
  completed_sbp_at_initiation +
  mi_sbp_at_initiation +
  
  completed_bmi_at_initiation +
  I(completed_bmi_at_initiation^2) +
  mi_bmi_at_initiation +
  
  # HbA1c: quadratic + cohort-year interaction
  completed_hba1c_at_initiation +
  I(completed_hba1c_at_initiation^2) +
  mi_hba1c_at_initiation +
  
  completed_hba1c_at_initiation:cohort_year_recoded +
  I(completed_hba1c_at_initiation^2):cohort_year_recoded +
  mi_hba1c_at_initiation:cohort_year_recoded +
  
  # Lipids
  completed_ldl_at_initiation +
  I(completed_ldl_at_initiation^2) +
  mi_ldl_at_initiation +
  
  completed_hdl_at_initiation +
  I(completed_hdl_at_initiation^2) +
  mi_hdl_at_initiation +
  
  # eGFR: spline + interactions
  ns(completed_egfr_at_initiation, df = 4) +
  mi_egfr_at_initiation +
  
  ns(completed_egfr_at_initiation, df = 4):cohort_year_recoded +
  mi_egfr_at_initiation:cohort_year_recoded +
  
  ns(completed_egfr_at_initiation, df = 4):male +
  ns(completed_egfr_at_initiation, df = 4):age_at_initiation +
  
  # Medication / treatment history
  su_before_initiation +
  metformin_monotherapy_before_initiation +
