  pivot_wider(names_from = group, values_from = risk, names_prefix = "risk_") %>%
  mutate(RD = risk_1 - risk_0, RR = risk_1 / risk_0)

iptw_cox_results <- tibble()
for (measure_name in c("risk_0", "risk_1", "RD", "RR")) {
  draw_values <- iptw_cox_draws[[measure_name]]
  valid_draws <- is.finite(draw_values)
  limits <- if (any(valid_draws)) {
    quantile(draw_values[valid_draws], c(0.025, 0.975), names = FALSE)
  } else c(NA_real_, NA_real_)
  iptw_cox_results <- bind_rows(iptw_cox_results, tibble(
    analysis = "iptw_cox", measure = measure_name, time_years = tau_years,
    estimate = iptw_cox_point[[measure_name]], lower = limits[1], upper = limits[2],
    n_boot_valid = sum(valid_draws), n_boot_available = nrow(iptw_cox_draws)
  ))
}

