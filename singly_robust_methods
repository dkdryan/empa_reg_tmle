# ------------------------------------------------------------------------------
# Extract HR + Wald 95% CI
# ------------------------------------------------------------------------------

extract_hr <- function(fit, term = "empa") {
  
  beta <- unname(coef(fit)[term])
  se   <- sqrt(unname(vcov(fit)[term, term]))
  
  c(
    estimate = exp(beta),
    lower    = exp(beta - 1.96 * se),
    upper    = exp(beta + 1.96 * se)
  )
}


# ------------------------------------------------------------------------------
# Marginal / g-computation risk at tau from a fitted Cox model
#
# S_i(t | A=a) = exp[-H0(t) exp(LP_i(a))]
# Risk_i(t | A=a) = 1 - S_i(t | A=a)
#
# Individual counterfactual risks are averaged over the analysis population.
# ------------------------------------------------------------------------------

standardise_cox <- function(fit, data, tau = 3 * 365.25) {
  
  data0 <- data
  data1 <- data
  
  data0$empa <- 0L
  data1$empa <- 1L
  
  bh <- basehaz(fit, centered = TRUE)
  idx <- which(bh$time <= tau)
  
  H0_tau <- if (length(idx) == 0) {
    0
  } else {
    bh$hazard[max(idx)]
  }
  
  lp0 <- predict(
    fit,
    newdata = data0,
    type = "lp",
    reference = "sample"
  )
  
  lp1 <- predict(
    fit,
    newdata = data1,
    type = "lp",
    reference = "sample"
  )
  
  risk0_i <- 1 - exp(-H0_tau * exp(lp0))
  risk1_i <- 1 - exp(-H0_tau * exp(lp1))
  
  risk0 <- mean(risk0_i, na.rm = TRUE)
  risk1 <- mean(risk1_i, na.rm = TRUE)
  
  c(
    risk_dpp4i = risk0,
    risk_empa  = risk1,
    RD         = risk1 - risk0,
    RR         = risk1 / risk0
  )
}


# ------------------------------------------------------------------------------
# Bootstrap standardised Cox estimands
# ------------------------------------------------------------------------------

bootstrap_standardised_cox <- function(
    data,
    formula,
    B = 1000,
    tau = 3 * 365.25,
    seed = 3001,
    label = "bootstrap") {
  
  set.seed(seed)
  
  out <- matrix(
    NA_real_,
    nrow = B,
    ncol = 4,
    dimnames = list(
      NULL,
      c("risk_dpp4i", "risk_empa", "RD", "RR")
    )
  )
  
  for (b in seq_len(B)) {
    
    idx <- sample.int(
      n = nrow(data),
      size = nrow(data),
      replace = TRUE
    )
    
    boot_data <- data[idx, , drop = FALSE]
    
    result_b <- tryCatch({
      
      boot_fit <- coxph(
        formula,
        data = boot_data,
        ties = "efron", 
        model = TRUE, 
        x = TRUE, 
        y = TRUE
      )
      
      standardise_cox(
        fit = boot_fit,
        data = boot_data,
        tau = tau
      )
      
    }, error = function(e) {
      
      message(
        sprintf(
          "%s failed at bootstrap %d: %s",
          label,
          b,
          conditionMessage(e)
        )
      )
      
      rep(NA_real_, 4)
    })
    
    out[b, ] <- result_b
    
    if (b %% 100 == 0 || b == B) {
      message(label, ": completed ", b, "/", B)
    }
  }
  
  as.data.frame(out)
}


# ------------------------------------------------------------------------------
# Percentile CI helper
# ------------------------------------------------------------------------------

percentile_ci <- function(x) {
  unname(
    quantile(
      x,
      probs = c(0.025, 0.975),
      na.rm = TRUE
    )
  )
}

