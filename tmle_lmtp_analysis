# ------------------------------------------------------------------------------
# IFE extraction
# ------------------------------------------------------------------------------

ife_value <- function(x) {
  as.numeric(
    x@x
  )
}


ife_se <- function(x) {
  as.numeric(
    x@std_error
  )
}


# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------

format_runtime <- function(
    seconds) {
  
  h <- floor(
    seconds / 3600
  )
  
  m <- floor(
    (
      seconds %% 3600
    ) / 60
  )
  
  s <- round(
    seconds %% 60
  )
  
  sprintf(
    "%02d:%02d:%02d",
    h,
    m,
    s
  )
}

# ------------------------------------------------------------------------------
# Extract mortality RD and RR from survival estimates
# ------------------------------------------------------------------------------

extract_effect_result <- function(
    fit_empa,
    fit_dpp4i) {
  
  survival_empa <- ife_value(
    fit_empa$estimate
  )
  
  survival_dpp4i <- ife_value(
    fit_dpp4i$estimate
  )
  
  
  risk_empa <- 1 - survival_empa
  risk_dpp4i <- 1 - survival_dpp4i
  
  
  # Mortality RD:
  # risk EMPA - risk DPP4i
  # = S_DPP4i - S_EMPA
  
  rd_object <- (
    fit_dpp4i$estimate -
      fit_empa$estimate
  )
  
  rd <- ife_value(
    rd_object
  )
  
  rd_se <- ife_se(
    rd_object
  )
  
  rd_lower <- rd - 1.96 * rd_se
  rd_upper <- rd + 1.96 * rd_se
  
  
  # Mortality RR
  
  logrr_object <- (
    log(
      1 -
        fit_empa$estimate
    ) -
      log(
        1 -
          fit_dpp4i$estimate
      )
  )
  
  
  logrr <- ife_value(
    logrr_object
  )
  
  logrr_se <- ife_se(
    logrr_object
  )
  
  
  rr <- exp(
    logrr
  )
  
  rr_lower <- exp(
    logrr -
      1.96 * logrr_se
  )
  
  rr_upper <- exp(
    logrr +
      1.96 * logrr_se
  )
  
  
  tibble(
    survival_empa = survival_empa,
    survival_dpp4i = survival_dpp4i,
    
    risk_empa = risk_empa,
    risk_dpp4i = risk_dpp4i,
    
    rd = rd,
    rd_se = rd_se,
    rd_lower = rd_lower,
    rd_upper = rd_upper,
    
    logrr = logrr,
    logrr_se = logrr_se,
    
    rr = rr,
    rr_lower = rr_lower,
    rr_upper = rr_upper
  )
}


# ------------------------------------------------------------------------------
# Add names to density-ratio matrix
# ------------------------------------------------------------------------------

name_dr_matrix <- function(
    x) {
  
  x <- as.matrix(
    x
  )
  
  colnames(x) <- paste0(
    "v",
    seq_len(
      ncol(x)
    )
  )
  
  x
}


# ------------------------------------------------------------------------------
# Cumulative product of density ratios
# ------------------------------------------------------------------------------

cumulative_density_ratios <- function(
    x) {
  
  x <- as.matrix(
    x
  )
  
  
  if (
    ncol(x) == 1
  ) {
    
    out <- x
    
  } else {
    
    out <- t(
      apply(
        x,
        1,
        cumprod
      )
    )
  }
  
  
  colnames(out) <- paste0(
    "cum_v",
    seq_len(
      ncol(out)
    )
  )
  
  out
}


# ------------------------------------------------------------------------------
# Save matrix with ID
# ------------------------------------------------------------------------------

save_matrix_with_id <- function(
    matrix_object,
    df,
    filename) {
  
  out <- bind_cols(
    df %>%
      select(
        person_id,
        empa
      ),
    as_tibble(
      matrix_object
    )
  )
  
  
  write.csv(
    out,
    filename,
    row.names = FALSE
  )
  
  invisible(
    out
  )
}


# ------------------------------------------------------------------------------
# Density-ratio summary
# ------------------------------------------------------------------------------

summarise_dr_all_timepoints <- function(
    matched_dr) {
  
  matched_dr %>%
    select(
      starts_with("v")
    ) %>%
    pivot_longer(
      everything(),
      names_to = "timepoint",
      values_to = "density_ratio"
    ) %>%
    mutate(
      timepoint = as.integer(
        sub(
          "^v",
          "",
          timepoint
        )
      )
    ) %>%
    group_by(
      timepoint
    ) %>%
    summarise(
      n_nonmissing = sum(
        !is.na(density_ratio)
      ),
      min = min(
        density_ratio,
        na.rm = TRUE
      ),
      median = median(
        density_ratio,
        na.rm = TRUE
      ),
      p95 = quantile(
        density_ratio,
        0.95,
        na.rm = TRUE
      ),
      p99 = quantile(
        density_ratio,
        0.99,
        na.rm = TRUE
      ),
      max = max(
        density_ratio,
        na.rm = TRUE
      ),
      .groups = "drop"
    )
}


# ------------------------------------------------------------------------------
# Format CI
# ------------------------------------------------------------------------------

format_ci <- function(
    estimate,
    lower,
    upper,
    digits = 2) {
  
  sprintf(
    paste0(
      "%.",
      digits,
      "f (%.",
      digits,
      "f, %.",
      digits,
      "f)"
    ),
    estimate,
    lower,
    upper
  )
}


# ==============================================================================
# 10. RUN ONE COMPLETE ANALYSIS
# ==============================================================================

run_one_analysis <- function(
    model_label,
    learner_library,
    trim_applied,
    trim_value) {
  
  trim_label <- if (
    trim_applied
  ) {
    "trim_Y"
  } else {
    "trim_N"
  }
  
  
  model_dir <- if (
    model_label == "Parametric GLM"
  ) {
    "parametric_GLM"
  } else {
    "superlearner"
  }
  
  
  RUN_DIR <- file.path(
    OUTPUT_DIR,
    model_dir,
    trim_label
  )
  
  
  dir.create(
    RUN_DIR,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  
  # ============================================================================
  # TIMER STARTS HERE
  # ============================================================================
  
  start_time <- Sys.time()
  
  
  message(
    "\n============================================================"
  )
  
  message(
    "\nSTART: ",
    model_label,
    " | trim=",
    ifelse(
      trim_applied,
      "Y",
      "N"
    ),
    " | ",
    start_time
  )
  
  message(
    "\n============================================================"
  )
  
  
  # ============================================================================
  # CONTROL
  # ============================================================================
  
  ctrl <- lmtp_control(
    .trim = trim_value,
    .learners_outcome_folds = NUISANCE_FOLDS,
    .learners_trt_folds = NUISANCE_FOLDS,
    .return_full_fits = FALSE,
    .info = TRUE
  )
  
  
  # ============================================================================
  # EMPA FIT
  # ============================================================================
  
  set.seed(
    SEED
  )
  
  
  fit_empa <- lmtp_tmle(
    data = df,
    trt = "empa",
    outcome = outcome_vars,
    cens = censor_vars,
    baseline = baseline_vars,
    shift = static_binary_on,
    mtp = FALSE,
    outcome_type = "survival",
    learners_outcome = learner_library,
    learners_trt = learner_library,
    folds = TMLE_FOLDS,
    control = ctrl
  )
  
  
  # Save immediately
  saveRDS(
    fit_empa,
    file.path(
      RUN_DIR,
      "fit_empa_FULL.rds"
    )
  )
  
  
  # ============================================================================
  # DPP-4i FIT
  # ============================================================================
  
  set.seed(
    SEED
  )
  
  
  fit_dpp4i <- lmtp_tmle(
    data = df,
    trt = "empa",
    outcome = outcome_vars,
    cens = censor_vars,
    baseline = baseline_vars,
    shift = static_binary_off,
    mtp = FALSE,
    outcome_type = "survival",
    learners_outcome = learner_library,
    learners_trt = learner_library,
    folds = TMLE_FOLDS,
    control = ctrl
  )
  
  
  # Save immediately
  saveRDS(
    fit_dpp4i,
    file.path(
      RUN_DIR,
      "fit_dpp4i_FULL.rds"
    )
  )
  
  
  # ============================================================================
  # TIMER ENDS AFTER BOTH TMLE FITS
  # ============================================================================
  
  end_time <- Sys.time()
  
  
  runtime_seconds <- as.numeric(
    difftime(
      end_time,
      start_time,
      units = "secs"
    )
  )
  
  
  # ============================================================================
  # EFFECT RESULTS
  # ============================================================================
  
  effect_result <- extract_effect_result(
    fit_empa = fit_empa,
    fit_dpp4i = fit_dpp4i
  )
  
  
  # ============================================================================
  # DENSITY RATIOS
  # ============================================================================
  
  dr_empa <- name_dr_matrix(
    fit_empa$density_ratios
  )
  
  dr_dpp4i <- name_dr_matrix(
    fit_dpp4i$density_ratios
  )
  
  
  dr_empa_df <- save_matrix_with_id(
    matrix_object = dr_empa,
    df = df,
    filename = file.path(
      RUN_DIR,
      "density_ratios_empa_ALL.csv"
    )
  )
  
  
  dr_dpp4i_df <- save_matrix_with_id(
    matrix_object = dr_dpp4i,
    df = df,
    filename = file.path(
      RUN_DIR,
      "density_ratios_dpp4i_ALL.csv"
    )
  )
  
  
  # ============================================================================
  # MATCH DR TO THE OBSERVED BASELINE TREATMENT
  #
  # Same logic as your existing diagnostic:
  #   EMPA intervention weights among actual EMPA initiators
  #   DPP-4i intervention weights among actual DPP-4i initiators
  # ============================================================================
  
  matched_dr <- bind_rows(
    
    dr_empa_df %>%
      filter(
        empa == 1
      ) %>%
      mutate(
        intervention = "EMPA"
      ),
    
    dr_dpp4i_df %>%
      filter(
        empa == 0
      ) %>%
      mutate(
        intervention = "DPP-4i"
      )
  )
  
  
  write.csv(
    matched_dr,
    file.path(
      RUN_DIR,
      "density_ratios_MATCHED_observed_treatment.csv"
    ),
    row.names = FALSE
  )
  
  
  # ============================================================================
  # CUMULATIVE WEIGHTS
  # ============================================================================
  
  cum_empa <- cumulative_density_ratios(
    dr_empa
  )
  
  cum_dpp4i <- cumulative_density_ratios(
    dr_dpp4i
  )
  
  
  save_matrix_with_id(
    matrix_object = cum_empa,
    df = df,
    filename = file.path(
      RUN_DIR,
      "cumulative_weights_empa_ALL.csv"
    )
  )
  
  
  save_matrix_with_id(
    matrix_object = cum_dpp4i,
    df = df,
    filename = file.path(
      RUN_DIR,
      "cumulative_weights_dpp4i_ALL.csv"
    )
  )
  
  
  # ============================================================================
  # DR1
  #
  # Restrict to those observed through interval 1, matching your previous code.
  # ============================================================================
  
  dr1 <- matched_dr %>%
    left_join(
      df %>%
        select(
          person_id,
          c_kplus1_1
        ),
      by = "person_id"
    ) %>%
    filter(
      c_kplus1_1 == 1,
      is.finite(v1)
    ) %>%
    arrange(
      desc(v1)
    )
  
  
  write.csv(
    dr1,
    file.path(
      RUN_DIR,
      "DR1_individual_values.csv"
    ),
    row.names = FALSE
  )
  
  
  write.csv(
    head(
      dr1,
      100
    ),
    file.path(
      RUN_DIR,
      "DR1_TOP100.csv"
    ),
    row.names = FALSE
  )
  
  
  # Overall DR1 summary used in final table
  dr1_summary <- dr1 %>%
    summarise(
      n = n(),
      min_dr1 = min(
        v1,
        na.rm = TRUE
      ),
      median_dr1 = median(
        v1,
        na.rm = TRUE
      ),
      p95_dr1 = quantile(
        v1,
        0.95,
        na.rm = TRUE
      ),
      p99_dr1 = quantile(
        v1,
        0.99,
        na.rm = TRUE
      ),
      max_dr1 = max(
        v1,
        na.rm = TRUE
      )
    )
  
  
  write.csv(
    dr1_summary,
    file.path(
      RUN_DIR,
      "DR1_summary.csv"
    ),
    row.names = FALSE
  )
  
  
  # By intervention
  dr1_by_treatment <- dr1 %>%
    group_by(
      intervention
    ) %>%
    summarise(
      n = n(),
      min_dr1 = min(
        v1,
        na.rm = TRUE
      ),
      median_dr1 = median(
        v1,
        na.rm = TRUE
      ),
      p95_dr1 = quantile(
        v1,
        0.95,
        na.rm = TRUE
      ),
      p99_dr1 = quantile(
        v1,
        0.99,
        na.rm = TRUE
      ),
      max_dr1 = max(
        v1,
        na.rm = TRUE
      ),
      .groups = "drop"
    )
  
  
  write.csv(
    dr1_by_treatment,
    file.path(
      RUN_DIR,
      "DR1_summary_by_treatment.csv"
    ),
    row.names = FALSE
  )
  
  
  # ============================================================================
  # ALL TIME-POINT WEIGHT SUMMARY
  # ============================================================================
  
  dr_all_summary <- summarise_dr_all_timepoints(
    matched_dr
  )
  
  
  write.csv(
    dr_all_summary,
    file.path(
      RUN_DIR,
      "density_ratio_summary_ALL_timepoints.csv"
    ),
    row.names = FALSE
  )
  
  
  # ============================================================================
  # OUTCOME REGRESSION OUTPUT
  # ============================================================================
  
  outcome_reg_empa <- as.data.frame(
    fit_empa$outcome_reg
  )
  
  outcome_reg_dpp4i <- as.data.frame(
    fit_dpp4i$outcome_reg
  )
  
  
  write.csv(
    bind_cols(
      person_id = df$person_id,
      outcome_reg_empa
    ),
    file.path(
      RUN_DIR,
      "outcome_regression_empa.csv"
    ),
    row.names = FALSE
  )
  
  
  write.csv(
    bind_cols(
      person_id = df$person_id,
      outcome_reg_dpp4i
    ),
    file.path(
      RUN_DIR,
      "outcome_regression_dpp4i.csv"
    ),
    row.names = FALSE
  )
  
  
  saveRDS(
    fit_empa$outcome_reg,
    file.path(
      RUN_DIR,
      "outcome_regression_empa.rds"
    )
  )
  
  
  saveRDS(
    fit_dpp4i$outcome_reg,
    file.path(
      RUN_DIR,
      "outcome_regression_dpp4i.rds"
    )
  )
  
  
  # ============================================================================
  # NUISANCE FITS / SL FITS
  # ============================================================================
  
  saveRDS(
    fit_empa$fits_m,
    file.path(
      RUN_DIR,
      "outcome_nuisance_fits_empa.rds"
    )
  )
  
  saveRDS(
    fit_empa$fits_r,
    file.path(
      RUN_DIR,
      "treatment_censoring_nuisance_fits_empa.rds"
    )
  )
  
  saveRDS(
    fit_dpp4i$fits_m,
    file.path(
      RUN_DIR,
      "outcome_nuisance_fits_dpp4i.rds"
    )
  )
  
  saveRDS(
    fit_dpp4i$fits_r,
    file.path(
      RUN_DIR,
      "treatment_censoring_nuisance_fits_dpp4i.rds"
    )
  )
  
  
  # ============================================================================
  # DR1 PLOTS
  # ============================================================================
  
  p_hist <- ggplot(
    dr1,
    aes(
      x = v1,
      fill = intervention
    )
  ) +
    geom_histogram(
      bins = 50,
      alpha = 0.55,
      position = "identity"
    ) +
    labs(
      x = "DR1",
      y = "Count",
      fill = "Treatment",
      title = paste0(
        model_label,
        " | trim ",
        ifelse(
          trim_applied,
          "Y",
          "N"
        )
      )
    ) +
    theme_classic(
      base_size = 12
    )
  
  
  ggsave(
    file.path(
      RUN_DIR,
      "DR1_histogram.png"
    ),
    p_hist,
    width = 7,
    height = 5,
    dpi = 300
  )
  
  
  p_density <- ggplot(
    dr1,
    aes(
      x = v1,
      colour = intervention,
      fill = intervention
    )
  ) +
    geom_density(
      alpha = 0.25,
      linewidth = 0.8
    ) +
    labs(
      x = "DR1",
      y = "Density",
      colour = "Treatment",
      fill = "Treatment",
      title = paste0(
        model_label,
        " | trim ",
        ifelse(
          trim_applied,
          "Y",
          "N"
        )
      )
    ) +
    theme_classic(
      base_size = 12
    )
  
  
  ggsave(
    file.path(
      RUN_DIR,
      "DR1_density.png"
    ),
    p_density,
    width = 7,
    height = 5,
    dpi = 300
  )
  
  
  # ============================================================================
  # MAX WEIGHT BY TIME POINT PLOT
  # ============================================================================
  
  p_max <- ggplot(
    dr_all_summary,
    aes(
      x = timepoint,
      y = max
    )
  ) +
    geom_line() +
    geom_point() +
    scale_x_continuous(
      breaks = seq_len(K)
    ) +
    labs(
      x = "Time point",
      y = "Maximum density ratio",
      title = paste0(
        model_label,
        " | trim ",
        ifelse(
          trim_applied,
          "Y",
          "N"
        )
      )
    ) +
    theme_classic(
      base_size = 12
    )
  
  
  ggsave(
    file.path(
      RUN_DIR,
      "maximum_density_ratio_by_timepoint.png"
    ),
    p_max,
    width = 7,
    height = 5,
    dpi = 300
  )
  
  
  # ============================================================================
  # FINAL RESULT ROW FOR THIS RUN
  # ============================================================================
  
  result <- effect_result %>%
    mutate(
      analysis = ANALYSIS_LABEL,
      nuisance_model = model_label,
      trim_applied = ifelse(
        trim_applied,
        "Y",
        "N"
      ),
      trim_value = trim_value,
      timepoints = K,
      
      min_dr1 = dr1_summary$min_dr1,
      median_dr1 = dr1_summary$median_dr1,
      p95_dr1 = dr1_summary$p95_dr1,
      p99_dr1 = dr1_summary$p99_dr1,
      max_dr1 = dr1_summary$max_dr1,
      
      runtime_seconds = runtime_seconds,
      runtime_minutes = runtime_seconds / 60,
      runtime = format_runtime(
        runtime_seconds
      ),
      
      start_time = as.character(
        start_time
      ),
      end_time = as.character(
        end_time
      ),
      
      learners = paste(
        learner_library,
        collapse = "; "
      )
    ) %>%
    select(
      analysis,
      nuisance_model,
      trim_applied,
      trim_value,
      timepoints,
      learners,
      
      survival_empa,
      survival_dpp4i,
      risk_empa,
      risk_dpp4i,
      
      rr,
      rr_lower,
      rr_upper,
      logrr,
      logrr_se,
      
      rd,
      rd_lower,
      rd_upper,
      rd_se,
      
      min_dr1,
      median_dr1,
      p95_dr1,
      p99_dr1,
      max_dr1,
      
      runtime_seconds,
      runtime_minutes,
      runtime,
      start_time,
      end_time
    )
  
  
  write.csv(
    result,
    file.path(
      RUN_DIR,
      "effect_result.csv"
    ),
    row.names = FALSE
  )
  
  
  write.csv(
    tibble(
      start_time = as.character(
        start_time
      ),
      end_time = as.character(
        end_time
      ),
      runtime_seconds = runtime_seconds,
      runtime_minutes = runtime_seconds / 60,
      runtime = format_runtime(
        runtime_seconds
      )
    ),
    file.path(
      RUN_DIR,
      "runtime.csv"
    ),
    row.names = FALSE
  )
  
  
  capture.output(
    sessionInfo(),
    file = file.path(
      RUN_DIR,
      "sessionInfo.txt"
    )
  )
  
  
  message(
    "\nFINISHED: ",
    model_label,
    " | trim=",
    ifelse(
      trim_applied,
      "Y",
      "N"
    ),
    " | runtime ",
    format_runtime(
      runtime_seconds
    )
  )
  
  
  # Remove large fit objects after all required output has been saved.
  rm(
    fit_empa,
    fit_dpp4i
  )
  
  gc()
  
  
  result
}


