SL.glmnet.ridge <- function(
    Y,
    X,
    newX,
    family,
    obsWeights,
    id,
    ...) {
  
  SuperLearner::SL.glmnet(
    Y = Y,
    X = X,
    newX = newX,
    family = family,
    obsWeights = obsWeights,
