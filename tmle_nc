# ==============================================================================
# 10. HELPERS SPECIFIC TO lmtp_survival NATURAL COURSE
# ==============================================================================

extract_survival_sl_weights <- function(
    survival_fit,
    component = c("fits_m", "fits_r")) {

  component <- match.arg(component)

  bind_rows(
    lapply(
      seq_along(survival_fit),
      function(horizon) {

        this_fit <- survival_fit[[horizon]]
        this_component <- this_fit[[component]]

        if (is.null(this_component)) {
          return(NULL)
        }

        extract_sl_weights_long(
          this_component
        ) %>%
          mutate(
            survival_horizon = horizon,
            .before = 1
          )
      }
    )
  )
}


# ==============================================================================
# 11. RUN ONE NATURAL-COURSE SURVIVAL ANALYSIS
# ==============================================================================

run_one_natural_course <- function(
    model_label,
    learner_library) {

  model_dir <- if (
    model_label == "Parametric GLM"
  ) {
    "parametric_GLM"
  } else {
    "superlearner"
  }


  RUN_DIR <- file.path(
    OUTPUT_DIR,
    model_dir,
    "trim_Y"
  )


  dir.create(
    RUN_DIR,
    recursive = TRUE,
    showWarnings = FALSE
  )


  # ============================================================================
  # TIMER STARTS HERE
  # ============================================================================

  start_time <- Sys.time()


  message(
    "\n============================================================"
  )

  message(
    "\nSTART NATURAL COURSE: ",
    model_label,
    " | trim=Y",
    " | ",
    start_time
  )

  message(
    "\n============================================================"
  )


  # ============================================================================
  # CONTROL
  # ============================================================================

  ctrl <- lmtp_control(
    .trim = TRIM_Y,
    .learners_outcome_folds = NUISANCE_FOLDS,
    .learners_trt_folds = NUISANCE_FOLDS,
    .return_full_fits = FALSE,
    .info = TRUE
  )


  # ============================================================================
  # NATURAL-COURSE SURVIVAL CURVE
  #
  # ============================================================================

  set.seed(
    SEED
  )


  fit_natural <- lmtp_survival(
    data = df,
    trt = "empa",
    outcomes = outcome_vars,
    baseline = baseline_vars,
    cens = censor_vars,
    shift = NULL,
    estimator = "lmtp_tmle",
    mtp = FALSE,
    learners_outcome = learner_library,
    learners_trt = learner_library,
    folds = TMLE_FOLDS,
    control = ctrl
  )


  # Save the complete survival-curve object immediately.
  saveRDS(
    fit_natural,
    file.path(
      RUN_DIR,
      "fit_natural_course_survival_FULL.rds"
    )
  )


  # ============================================================================
  # TIMER ENDS AFTER SURVIVAL CURVE FIT
  # ============================================================================

  end_time <- Sys.time()


  runtime_seconds <- as.numeric(
    difftime(
      end_time,
      start_time,
      units = "secs"
    )
  )


  # ============================================================================
  # TIDY NATURAL-COURSE SURVIVAL CURVE
  # ============================================================================

  survival_curve <- generics::tidy(
    fit_natural
  ) %>%
    as_tibble() %>%
    mutate(
      risk = 1 - estimate,
      risk_lower = 1 - conf.high,
      risk_upper = 1 - conf.low
    )


  write.csv(
    survival_curve,
    file.path(
      RUN_DIR,
      "natural_course_survival_curve.csv"
    ),
    row.names = FALSE
  )


  # Final time point = requested end of follow-up.
  final_point <- survival_curve %>%
    filter(
      time == max(time)
    ) %>%
    slice(1)


  # ============================================================================
  # FULL-HORIZON DIAGNOSTICS
  # ============================================================================

  final_fit <- fit_natural[[length(fit_natural)]]


  dr_natural <- name_dr_matrix(
    final_fit$density_ratios
  )


  dr_natural_df <- save_matrix_with_id(
    matrix_object = dr_natural,
    df = df,
    filename = file.path(
      RUN_DIR,
      "density_ratios_natural_course_ALL.csv"
    )
  )


  cum_natural <- cumulative_density_ratios(
    dr_natural
  )


  save_matrix_with_id(
    matrix_object = cum_natural,
    df = df,
    filename = file.path(
      RUN_DIR,
      "cumulative_weights_natural_course_ALL.csv"
    )
  )


  # ============================================================================
  # DR1
  # ============================================================================

  dr1 <- dr_natural_df %>%
    left_join(
      df %>%
        select(
          person_id,
          c_kplus1_1
        ),
      by = "person_id"
    ) %>%
    filter(
      c_kplus1_1 == 1,
      is.finite(v1)
    ) %>%
    arrange(
      desc(v1)
    )


  write.csv(
    dr1,
    file.path(
      RUN_DIR,
      "DR1_individual_values.csv"
    ),
    row.names = FALSE
  )


  write.csv(
    head(
      dr1,
      100
    ),
    file.path(
      RUN_DIR,
      "DR1_TOP100.csv"
    ),
    row.names = FALSE
  )


  dr1_summary <- dr1 %>%
    summarise(
      n = n(),
      min_dr1 = min(
        v1,
        na.rm = TRUE
      ),
      median_dr1 = median(
        v1,
        na.rm = TRUE
      ),
      p95_dr1 = quantile(
        v1,
        0.95,
        na.rm = TRUE
      ),
      p99_dr1 = quantile(
        v1,
        0.99,
        na.rm = TRUE
      ),
      max_dr1 = max(
        v1,
        na.rm = TRUE
      )
    )


  write.csv(
    dr1_summary,
    file.path(
      RUN_DIR,
      "DR1_summary.csv"
    ),
    row.names = FALSE
  )


  # ============================================================================
  # ALL TIME-POINT DENSITY-RATIO SUMMARY
  # ============================================================================

  dr_all_summary <- summarise_dr_all_timepoints(
    dr_natural_df
  )


  write.csv(
    dr_all_summary,
    file.path(
      RUN_DIR,
      "density_ratio_summary_ALL_timepoints.csv"
    ),
    row.names = FALSE
  )


  # ============================================================================
  # OUTCOME REGRESSION OUTPUT FROM FINAL HORIZON
  # ============================================================================

  outcome_reg_natural <- as.data.frame(
    final_fit$outcome_reg
  )


  write.csv(
    bind_cols(
      person_id = df$person_id,
      outcome_reg_natural
    ),
    file.path(
      RUN_DIR,
      "outcome_regression_natural_course_final_horizon.csv"
    ),
    row.names = FALSE
  )


  saveRDS(
    final_fit$outcome_reg,
    file.path(
      RUN_DIR,
      "outcome_regression_natural_course_final_horizon.rds"
    )
  )


  # ============================================================================
  # NUISANCE FITS / SUPER LEARNER WEIGHTS
  # ============================================================================

  saveRDS(
    lapply(
      fit_natural,
      function(x) x$fits_m
    ),
    file.path(
      RUN_DIR,
      "outcome_nuisance_fits_natural_course_ALL_horizons.rds"
    )
  )


  saveRDS(
    lapply(
      fit_natural,
      function(x) x$fits_r
    ),
    file.path(
      RUN_DIR,
      "treatment_censoring_nuisance_fits_natural_course_ALL_horizons.rds"
    )
  )


  write.csv(
    extract_survival_sl_weights(
      fit_natural,
      component = "fits_m"
    ),
    file.path(
      RUN_DIR,
      "SL_weights_outcome_natural_course_ALL_horizons.csv"
    ),
    row.names = FALSE
  )


  write.csv(
    extract_survival_sl_weights(
      fit_natural,
      component = "fits_r"
    ),
    file.path(
      RUN_DIR,
      "SL_weights_treatment_censoring_natural_course_ALL_horizons.csv"
    ),
    row.names = FALSE
  )


  # ============================================================================
  # PLOTS
  # ============================================================================

  p_survival <- ggplot(
    survival_curve,
    aes(
      x = time,
      y = estimate
    )
  ) +
    geom_line() +
    geom_point() +
    geom_ribbon(
      aes(
        ymin = conf.low,
        ymax = conf.high
      ),
      alpha = 0.2
    ) +
    labs(
      x = "Time point",
      y = "Natural-course survival",
      title = paste0(
        "Natural course | ",
        model_label
      )
    ) +
    theme_classic(
      base_size = 12
    )


  ggsave(
    file.path(
      RUN_DIR,
      "natural_course_survival_curve.png"
    ),
    p_survival,
    width = 7,
    height = 5,
    dpi = 300
  )


  p_hist <- ggplot(
    dr1,
    aes(
      x = v1
    )
  ) +
    geom_histogram(
      bins = 50
    ) +
    labs(
      x = "DR1",
      y = "Count",
      title = paste0(
        "Natural course | ",
        model_label,
        " | trim Y"
      )
    ) +
    theme_classic(
      base_size = 12
    )


  ggsave(
    file.path(
      RUN_DIR,
      "DR1_histogram.png"
    ),
    p_hist,
    width = 7,
    height = 5,
    dpi = 300
  )


  p_max <- ggplot(
    dr_all_summary,
    aes(
      x = timepoint,
      y = max
    )
  ) +
    geom_line() +
    geom_point() +
    scale_x_continuous(
      breaks = seq_len(K)
    ) +
    labs(
      x = "Time point",
      y = "Maximum density ratio",
      title = paste0(
        "Natural course | ",
        model_label,
        " | trim Y"
      )
    ) +
    theme_classic(
      base_size = 12
    )


  ggsave(
    file.path(
      RUN_DIR,
      "maximum_density_ratio_by_timepoint.png"
    ),
    p_max,
    width = 7,
    height = 5,
    dpi = 300
  )


  # ============================================================================
  # FINAL RESULT ROW
  # ============================================================================

  result <- tibble(
    analysis = ANALYSIS_LABEL,
    estimand = "Natural course",
    nuisance_model = model_label,
    trim_applied = "Y",
    trim_value = TRIM_Y,
    timepoints = K,
    learners = paste(
      learner_library,
      collapse = "; "
    ),

    survival = final_point$estimate,
    survival_se = final_point$std.error,
    survival_lower = final_point$conf.low,
    survival_upper = final_point$conf.high,

    risk = final_point$risk,
    risk_se = final_point$std.error,
    risk_lower = final_point$risk_lower,
    risk_upper = final_point$risk_upper,

    min_dr1 = dr1_summary$min_dr1,
    median_dr1 = dr1_summary$median_dr1,
    p95_dr1 = dr1_summary$p95_dr1,
    p99_dr1 = dr1_summary$p99_dr1,
    max_dr1 = dr1_summary$max_dr1,

    runtime_seconds = runtime_seconds,
    runtime_minutes = runtime_seconds / 60,
    runtime = format_runtime(
      runtime_seconds
    ),

    start_time = as.character(
      start_time
    ),
    end_time = as.character(
      end_time
    )
  )


  write.csv(
    result,
    file.path(
      RUN_DIR,
      "natural_course_final_result.csv"
    ),
    row.names = FALSE
  )


  write.csv(
    tibble(
      start_time = as.character(
        start_time
      ),
      end_time = as.character(
        end_time
      ),
      runtime_seconds = runtime_seconds,
      runtime_minutes = runtime_seconds / 60,
      runtime = format_runtime(
        runtime_seconds
      )
    ),
    file.path(
      RUN_DIR,
      "runtime.csv"
    ),
    row.names = FALSE
  )


  capture.output(
    sessionInfo(),
    file = file.path(
      RUN_DIR,
      "sessionInfo.txt"
    )
  )


  message(
    "\nFINISHED NATURAL COURSE: ",
    model_label,
    " | trim=Y",
    " | runtime ",
    format_runtime(
      runtime_seconds
    )
  )


  rm(
    fit_natural,
    final_fit
  )

  gc()


  result
}


