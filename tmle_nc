patch_lmtp_run_ensemble <- function() {
  
  ns <- asNamespace("lmtp")
  
  original <- get(
    "run_ensemble",
    envir = ns
  )
  
  
  expected_args <- c(
    "data",
    "y",
    "learners",
    "outcome_type",
    "id",
    "folds"
  )
  
  
  if (
    !identical(
      names(
        formals(original)
      ),
      expected_args
    )
  ) {
    
    stop(
      paste0(
        "Your lmtp:::run_ensemble() signature differs from the version ",
        "this script was written for. Check packageVersion('lmtp')."
      )
    )
  }
  
  
  patched <- function(
    data,
    y,
    learners,
    outcome_type,
    id,
    folds) {
    
    n_ids <- length(
      unique(
        data[[id]]
      )
    )
    
    if (
      folds > n_ids
    ) {
      stop(
        "Number of nuisance folds exceeds number of unique IDs."
      )
    }
    
    
    family <- if (
      outcome_type == "binomial"
    ) {
      binomial()
    } else {
      gaussian()
    }
    
    
    cv_control <- SuperLearner::SuperLearner.CV.control(
      V = folds
    )
    
    
    features <- setdiff(
      names(data),
      c(
        id,
        y
      )
    )
    
    
    X <- data[
      ,
      features,
      drop = FALSE
    ]
    
    Y <- data[[y]]
    
    
    fit <- SuperLearner::SuperLearner(
      Y = Y,
      X = X,
      family = family,
      SL.library = learners,
      id = data[[id]],
      method = "method.NNLS",
      env = globalenv(),
      cvControl = cv_control
    )
    
    
    class(fit) <- c(
      "lmtp_ensemble",
      class(fit)
    )
    
    fit
  }
  
  
  assignInNamespace(
    x = "run_ensemble",
    value = patched,
    ns = "lmtp"
  )
  
  
  original
}


restore_lmtp_run_ensemble <- function(
    original) {
  
  assignInNamespace(
    x = "run_ensemble",
    value = original,
    ns = "lmtp"
  )
  
  invisible(NULL)
}


