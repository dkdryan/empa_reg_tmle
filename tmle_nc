# ------------------------------------------------------------------------------
# Flatten lmtp Super Learner coefficient lists (fits_m / fits_r)
# ------------------------------------------------------------------------------

extract_sl_weights_long <- function(fits) {

  bind_rows(
    lapply(
      seq_along(fits),
      function(fold_index) {

        fold_fits <- fits[[fold_index]]

        bind_rows(
          lapply(
            seq_along(fold_fits),
            function(time_index) {

              w <- fold_fits[[time_index]]

              if (is.null(w) || length(w) == 0) {
                return(NULL)
              }

              w_num <- as.numeric(w)
              w_names <- names(w)

              if (is.null(w_names) || length(w_names) != length(w_num)) {
                w_names <- paste0("learner_", seq_along(w_num))
              }

              tibble(
                outer_fold = fold_index,
                timepoint = time_index,
                learner = w_names,
                weight = w_num
              )
            }
          )
        )
      }
    )
  )
}


# ------------------------------------------------------------------------------
# Density-ratio summary
# ------------------------------------------------------------------------------

summarise_dr_all_timepoints <- function(
    matched_dr) {
  
  matched_dr %>%
    select(
      starts_with("v")
    ) %>%
    pivot_longer(
      everything(),
      names_to = "timepoint",
      values_to = "density_ratio"
    ) %>%
    mutate(
      timepoint = as.integer(
        sub(
          "^v",
          "",
          timepoint
        )
      )
    ) %>%
    group_by(
      timepoint
    ) %>%
    summarise(
      n_nonmissing = sum(
        !is.na(density_ratio)
      ),
      min = min(
        density_ratio,
        na.rm = TRUE
      ),
      median = median(
        density_ratio,
        na.rm = TRUE
      ),
      p95 = quantile(
        density_ratio,
        0.95,
        na.rm = TRUE
      ),
      p99 = quantile(
        density_ratio,
        0.99,
        na.rm = TRUE
      ),
      max = max(
        density_ratio,
        na.rm = TRUE
      ),
      .groups = "drop"
    )
}


