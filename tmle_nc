# ------------------------------------------------------------------------------
# IFE extraction
# ------------------------------------------------------------------------------

ife_value <- function(x) {
  as.numeric(
    x@x
  )
}


ife_se <- function(x) {
  as.numeric(
    x@std_error
  )
}


# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------

format_runtime <- function(
    seconds) {
  
  h <- floor(
    seconds / 3600
  )
  
  m <- floor(
    (
      seconds %% 3600
    ) / 60
  )
  
  s <- round(
    seconds %% 60
  )
  
  sprintf(
    "%02d:%02d:%02d",
    h,
    m,
    s
  )
}

# ------------------------------------------------------------------------------
# Extract mortality RD and RR from survival estimates
# ------------------------------------------------------------------------------

extract_effect_result <- function(
    fit_empa,
    fit_dpp4i) {
  
  survival_empa <- ife_value(
    fit_empa$estimate
  )
  
  survival_dpp4i <- ife_value(
    fit_dpp4i$estimate
  )
  
  
  risk_empa <- 1 - survival_empa
  risk_dpp4i <- 1 - survival_dpp4i
  
  
  # Mortality RD:
  # risk EMPA - risk DPP4i
  # = S_DPP4i - S_EMPA
  
  rd_object <- (
    fit_dpp4i$estimate -
      fit_empa$estimate
  )
  
  rd <- ife_value(
    rd_object
  )
  
  rd_se <- ife_se(
    rd_object
  )
  
  rd_lower <- rd - 1.96 * rd_se
  rd_upper <- rd + 1.96 * rd_se
  
  
  # Mortality RR
  
  logrr_object <- (
    log(
      1 -
        fit_empa$estimate
    ) -
      log(
        1 -
          fit_dpp4i$estimate
      )
  )
  
  
  logrr <- ife_value(
    logrr_object
  )
  
  logrr_se <- ife_se(
    logrr_object
  )
  
  
  rr <- exp(
    logrr
  )
  
  rr_lower <- exp(
    logrr -
      1.96 * logrr_se
  )
  
  rr_upper <- exp(
    logrr +
      1.96 * logrr_se
  )
  
  
  tibble(
    survival_empa = survival_empa,
    survival_dpp4i = survival_dpp4i,
    
    risk_empa = risk_empa,
    risk_dpp4i = risk_dpp4i,
    
    rd = rd,
    rd_se = rd_se,
    rd_lower = rd_lower,
    rd_upper = rd_upper,
    
    logrr = logrr,
    logrr_se = logrr_se,
    
    rr = rr,
    rr_lower = rr_lower,
    rr_upper = rr_upper
  )
}


# ------------------------------------------------------------------------------
# Add names to density-ratio matrix
# ------------------------------------------------------------------------------

name_dr_matrix <- function(
    x) {
  
  x <- as.matrix(
    x
  )
  
  colnames(x) <- paste0(
    "v",
    seq_len(
      ncol(x)
    )
  )
  
  x
}


# ------------------------------------------------------------------------------
# Cumulative product of density ratios
# ------------------------------------------------------------------------------

cumulative_density_ratios <- function(
    x) {
  
  x <- as.matrix(
    x
  )
  
  
  if (
    ncol(x) == 1
  ) {
    
    out <- x
    
  } else {
    
    out <- t(
      apply(
        x,
        1,
        cumprod
      )
    )
  }
  
  
  colnames(out) <- paste0(
    "cum_v",
    seq_len(
      ncol(out)
    )
  )
  
  out
}


